# Clash Royale Skill-based Agent local configuration example.
# Copy to .env for local use. Do not commit real API keys.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_BASE_URL=https://crs.ruinique.com
OPENAI_WIRE_API=responses
OPENAI_REASONING_EFFORT=medium
PARSER_REASONING_EFFORT=medium
SYNTHESIS_REASONING_EFFORT=medium

# Local development binds to loopback. Container deployments override this to 0.0.0.0.
RUNTIME_HOST=127.0.0.1
RUNTIME_PORT=8091
RUNTIME_ROLE=all
SNAPSHOT_FOLLOWER_POLL_SECONDS=30
RAG_INDEX_MODE=persistent

WEB_HOST=127.0.0.1
WEB_PORT=8080
BACKEND_URL=http://127.0.0.1:8091/process
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
MAX_REQUEST_BODY_BYTES=65536
MAX_QUERY_CHARS=8000
PROCESS_MAX_CONCURRENT=8
PROCESS_RATE_LIMIT_PER_MINUTE=30
# Only needed if the disabled live-sample admin endpoint is explicitly enabled.
ADMIN_API_KEY=

OLLAMA_EMBED_URL=http://localhost:11434/api/embed
EMBED_MODEL=bge-m3:latest
OLLAMA_EMBED_TIMEOUT_SECONDS=10
PARSER_CALL_TIMEOUT_SECONDS=45
MODEL_CALL_TIMEOUT_SECONDS=120
MODEL_CIRCUIT_FAILURE_THRESHOLD=3
MODEL_CIRCUIT_RECOVERY_SECONDS=60

RETRIEVAL_TOP_K_BM25=10
RETRIEVAL_TOP_K_DENSE=10
RETRIEVAL_FINAL_TOP_K=8
RETRIEVAL_ALPHA=0.5
RERANK_TOP_N=4
COMPRESS_MAX_ITEMS=4
COMPRESS_CHAR_BUDGET=1200
RAG_QUALITY_GATE_ENABLED=true
RAG_MIN_DOCUMENTS=100
RAG_MIN_SOURCE_TYPES=6
RAG_MIN_PROBE_RECALL_PERCENT=60
RAG_PROBES_PER_SOURCE=3
RAG_FACT_VALIDATION_ENABLED=true
FEEDBACK_DB_FILE=data/feedback.sqlite3
FEEDBACK_CACHE_MAX_ITEMS=512
FEEDBACK_CACHE_TTL_SECONDS=3600
FEEDBACK_MAX_CORRECTION_CHARS=4000
LOG_FORMAT=text
SITE_ADDRESS=https://localhost
GRAFANA_ADMIN_PASSWORD=change-this-before-deployment

# Official Supercell API. The token must be generated for the server's public IP.
SUPERCELL_API_TOKEN=
SUPERCELL_LIVE_DATA_ENABLED=true
# In production, require successful model and Supercell API calls rather than
# silently presenting repository snapshots as live data.
EXTERNAL_API_REQUIRED=true
SUPERCELL_API_TIMEOUT_SECONDS=15
SUPERCELL_CACHE_TTL_SECONDS=86400
# Production always publishes exactly one complete 20,000-battle official
# snapshot per day. SUPERCELL_TARGET_BATTLES is intentionally ignored.
# Candidate pool is fetched through leaderboard cursors in rank order. The
 # collector stops as soon as it obtains 20,000 unique usable battles.
SUPERCELL_LEADERBOARD_PLAYERS=3000
SUPERCELL_BATTLES_PER_PLAYER=25
# Rank order is strict in production; this setting is ignored and remains 1.
SUPERCELL_FETCH_CONCURRENCY=1
# Runtime sample-size changes are disabled; daily collection is fixed at 20,000.
LIVE_SAMPLE_SETTINGS_ADMIN_ENABLED=false
SUPERCELL_HIGH_VOLUME_REQUESTS_PER_SECOND=2
SUPERCELL_HIGH_VOLUME_MAX_RETRIES=0
# Defaults to 3600 seconds and is capped at 7200 seconds.
SUPERCELL_HIGH_VOLUME_MAX_REFRESH_SECONDS=3600
# Optional comma-separated whitelist, used only when both official global ranking sources are empty.
SUPERCELL_FALLBACK_PLAYER_TAGS=
