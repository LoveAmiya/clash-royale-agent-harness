# Clash Royale Skill-based Agent local configuration example.
# Copy to .env for local use. Do not commit real API keys.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_BASE_URL=https://crs.ruinique.com
OPENAI_WIRE_API=responses
OPENAI_REASONING_EFFORT=medium
PARSER_REASONING_EFFORT=medium
SYNTHESIS_REASONING_EFFORT=medium

RUNTIME_HOST=0.0.0.0
RUNTIME_PORT=8091

WEB_HOST=0.0.0.0
WEB_PORT=8080
BACKEND_URL=http://127.0.0.1:8091/process

OLLAMA_EMBED_URL=http://localhost:11434/api/embed
EMBED_MODEL=bge-m3:latest
OLLAMA_EMBED_TIMEOUT_SECONDS=3
PARSER_CALL_TIMEOUT_SECONDS=20
MODEL_CALL_TIMEOUT_SECONDS=120

RETRIEVAL_TOP_K_BM25=10
RETRIEVAL_TOP_K_DENSE=10
RETRIEVAL_FINAL_TOP_K=8
RETRIEVAL_ALPHA=0.5
RERANK_TOP_N=4
COMPRESS_MAX_ITEMS=4
COMPRESS_CHAR_BUDGET=1200
